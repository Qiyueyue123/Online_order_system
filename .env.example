SECRET_KEY=replace-with-a-random-secret-key
ADMIN_USERNAME=admin

# Use 1 for the public menu + WhatsApp/Telegram order flow.
# Use 0 to show the built-in checkout/order database flow.
MANUAL_ORDER_ONLY=1

# Telegram handle and WhatsApp number used by public order buttons.
CAFE_CONTACT_LINE="WhatsApp or Telegram for orders and questions:"
CAFE_CONTACT_PHONE="@notqiyue"
CAFE_WHATSAPP_PHONE="+6597888146"

# Use 0 for local http://localhost Docker Compose.
# Use 1 in production behind HTTPS.
SESSION_COOKIE_SECURE=0

# Paste the full output from:
# python -m flask --app run hash-password "your-strong-password"
#
# Keep the single quotes. Argon2 password hashes contain "$", and Docker
# Compose treats unquoted "$..." text as environment-variable interpolation.
ADMIN_PASSWORD_HASH='paste-full-argon2-password-hash-here'
